# Claude Code. Share the launch config; never the local settings — they hold API
# keys and tokens, and this repository is public.
.claude/*
!.claude/launch.json

# Stray generated training artifact (kept on disk, not tracked)
/auction-training-video-player.html

# Android signing. Private keys and their passwords — never commit these.
# They were tracked in a public repo from bfddcf2 until this commit, so the
# keys in that history are burned; generate fresh ones before any release.
*.keystore
*.jks
keystore.properties
key.properties
android/key.properties
