# Copy to .env and fill in. The key stays on the server; it is never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# Set to claude-sonnet-5 for ~5x lower cost with strong quality.
MODEL=claude-opus-5

# Optional. Port the server listens on (default 8787).
PORT=8787
